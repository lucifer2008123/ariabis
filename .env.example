# HaggleOS / The Negotiator - Environment Variables

# MongoDB Atlas Database URI
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/haggle_os_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/haggle_os_prod

# Base URL for Web Portal & Webhooks
NEXT_PUBLIC_BASE_URL=https://haggleos.xyz
PORTAL_BASE_URL=https://haggleos.xyz

# n8n Pro Cloud Webhook Ingress (hooks.haggleos.xyz)
N8N_WEBHOOK_URL=https://hooks.haggleos.xyz
N8N_API_KEY=n8n_api_key_placeholder

# Telephony: Vapi.ai / Retell
VAPI_API_KEY=vapi_api_key_placeholder
VAPI_ASSISTANT_ID=vapi_assistant_id_placeholder
VAPI_PHONE_NUMBER_ID=vapi_phone_number_id_placeholder

# Market Research APIs
TAVILY_API_KEY=tvly_placeholder
PERPLEXITY_API_KEY=pplx_placeholder
GOOGLE_PLACES_API_KEY=google_places_placeholder

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=whatsapp_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=whatsapp_phone_id_placeholder

# Audio CDN (Cloudflare R2 / S3)
AUDIO_CDN_BASE_URL=https://cdn.haggleos.xyz
